# ==============================================================
# Bolão da Copa 2026 — Variáveis de Ambiente
# ==============================================================
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite o .env.local — ele já está no .gitignore.
#
# Encontre as chaves em: supabase.com > seu projeto > Settings > API
# ==============================================================

# URL pública do projeto Supabase (pode ir ao cliente)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave anon/pública do Supabase (pode ir ao cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role do Supabase — APENAS SERVER-SIDE
# NUNCA exponha esta chave no cliente ou em logs
SUPABASE_SERVICE_ROLE_KEY=
