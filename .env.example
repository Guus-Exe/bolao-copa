# ==============================================================
# Bolão da Copa 2026 — Variáveis de Ambiente
# ==============================================================
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite o .env.local — ele já está no .gitignore.
#
# Encontre as chaves em: supabase.com > seu projeto > Settings > API
# ==============================================================

# URL pública do projeto Supabase (pode ir ao cliente)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave anon/pública do Supabase (pode ir ao cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role do Supabase — APENAS SERVER-SIDE
# NUNCA exponha esta chave no cliente ou em logs
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================
# Vercel Cron — proteção do endpoint /api/cron/sync-scores
# ==============================================================
# Gere um valor aleatório: openssl rand -hex 32
# Adicione como variável de ambiente no painel da Vercel
CRON_SECRET=

# ==============================================================
# API-Football — sincronização automática de resultados
# ==============================================================
# Obtenha em: https://www.api-football.com
# Opcional: se não configurar, o cron não atualiza resultados
API_FOOTBALL_KEY=
